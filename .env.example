APP_NAME=Translate-Portfolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# 画面もログも日本語に寄せる。fallback も ja にして
# 未翻訳キーが英語で漏れないようにする
APP_LOCALE=ja
APP_FALLBACK_LOCALE=ja
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- データベース: PostgreSQL 16（docker-compose で起動） ---
# ホスト PHP から docker のコンテナへ 127.0.0.1:5432 で接続する
# 下の値は docker-compose.yml と一致させること
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=translate_portfolio
DB_USERNAME=app
DB_PASSWORD=secret

# --- セッション / キュー / キャッシュ: すべて Redis に集約 ---
# セッションを Redis に置くことで DB マイグレーション不要＆高速
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ジョブ（メタデータ取得→字幕取得→要約）を回すキュー
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# ホスト PHP に phpredis 拡張が無いので、純 PHP 実装の predis を使う
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- 外部 API（各自で取得してセットする） ---
# Claude Messages API キー: https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# YouTube Data API v3 キー: https://console.cloud.google.com/ で発行
YOUTUBE_API_KEY=
